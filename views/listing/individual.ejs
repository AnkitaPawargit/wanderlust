<% layout('layouts/boilerplate') -%>
<style>

#map {
    width: 63% !important;
    height: 400px !important;         /* smaller height */
    margin:auto;
}
</style>

<div class="card individual listing-card" >
  <img src="<%= data.image.url %>" class="card-img-top" alt="Image" >
  <div class="card-body">
    <p class="card-text">
        <i>Owner : <%= data.owner.username %></i>
        <h3><%= data.title %></h3>
        <p><%= data.desc %><br>
        <%= data.price %><br>
        <%= data.location %><br>
        <%= data.country %><br>
        <% if(currentUser && currentUser._id.equals(data.owner._id)) {%>     <!-- here we are making sure that only the owner of the lsiting gets to see the edit and delete buttons this is the logic for only the user side for use but still the people from hoptscotch etc can make changes so for that we need validations made in index.js -->
        <form action="/listing/<%= data._id %>/edit" method="get">
        <button class="btn mb-3 btn-dark editbtn">EDIT</button>
        </form>
        <form action="/listing/<%= data._id %>?_method=DELETE" method="post">
        <button class="btn mb-3 btn-dark">DELETE</button>
        </form>
        <% } %>
    </p>
  </div>
</div>
<div class="formbox">
  <% if(currentUser){%>
  <h3>Add Reviews</h3>
  <form action="/listing/<%= data._id %>/review" method="post" novalidate class="needs-validation" required>
   <!-- <div class="mt-3">
    <label for="rating">Rating</label>
    <input type="range" name="list[rating]" id="rating" class="form-control" min="1" max="5">
   </div> -->
   <div class="mt-3">
    <label for="rating">Rating</label>
   <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="list[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="list[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="list[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="list[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="list[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="list[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>

   <div class="mt-3">
    <label for="comment">Comment</label>
    <textarea name="list[comment]" id="comment" class="form-control" required></textarea>
   </div>
   <div class="mt-3 mb-3">
    <button class="btn btn-dark">Submit</button>
   </div>
  </form>
<% } %>
</div>

<div class="reviewssection">
  <h3>See Reviews</h3>

  <div class="row">
    <% for(let review of data.reviews){ %>
      <div class="col-12 col-md-6 mb-3">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title mt-3 mb-3 ms-3">@<%= review.author.username %></h5>
            <p class="starability-result card-text ms-3" data-rating="<%= review.rating %>"></p>
            <p class="card-text mt-3 mb-3 ms-3 ">Comment : <%= review.comment %></p>
          </div>
          <form action="/listing/<%= data._id %>/review/<%= review._id %>?_method=DELETE" method="post">
          <button type="submit" class="btn btn-dark mb-3 ms-3">DELETE</button>
        </form>
        </div>
      </div>
    <% } %>
  </div>
</div>
<div id="map" style="height: 400px; margin-bottom: 50px;"></div>

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>
  <% if (data.coordinates && data.coordinates.lat != null && data.coordinates.lng != null) { %>
    const lat = <%- JSON.stringify(data.coordinates.lat) %>;
    const lng = <%- JSON.stringify(data.coordinates.lng) %>;

    const map = L.map("map").setView([lat, lng], 13);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "© OpenStreetMap contributors"
    }).addTo(map);

    L.marker([lat, lng]).addTo(map)
      .bindPopup("<%= data.location %>")
      .openPopup();
  <% } else { %>
    document.getElementById("map").innerHTML = "<p>No location available</p>";
  <% } %>
</script>

