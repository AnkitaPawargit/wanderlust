<% layout('layouts/boilerplate') -%>

<style>
    .filters{
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }
    .filter{
        text-align: center;
        margin-right: 2rem;
        opacity: 0.8;
        cursor: pointer;
    }
    .filter:hover{
        opacity: 1;
        border-bottom: 2px solid black;
        cursor: pointer;
    }
    .toggle-box{
        border:2px solid black;
        border-radius: 20px;
        height: 3rem;
        padding: 5.9px 15px 0px 15px;
        margin-left: 3rem;
    }
    .GST{
        display: none;
    }
    .filters a{
        text-decoration: none;
        color: black;
    }
</style>
    <div class="filters">
        <a href="/listing/category/trending">
            <div class="filter">
            <div>
                <i class="fa-solid fa-fire"></i>
            </div>
            <p>Trending</p>
        </div>
        </a>
        <a href="/listing/category/bedrooms">
            <div class="filter">
            <div>
                <i class="fa-solid fa-bed"></i>
            </div>
            <p>bedrooms</p>
        </div>
        </a>
        <a href="/listing/category/mountains">
            <div class="filter">
            <div>
                <i class="fa-solid fa-mountain-city"></i>
            </div>
            <p>Mountains</p>
        </div>
        </a>
        <a href="/listing/category/castle">
            <div class="filter">
            <div>
                <i class="fa-brands fa-fort-awesome"></i>
            </div>
            <p>Castle</p>
        </div>
        </a>
        <a href="/listing/category/forest">
            <div class="filter">
            <div>
                <i class="fa-solid fa-tree"></i>
            </div>
            <p>forest</p>
        </div>
        </a>
        <a href="/listing/category/artic">
            <div class="filter">
            <div>
                <i class="fa-solid fa-snowflake"></i>
            </div>
            <p>Artic</p>
        </div>
        </a>
        <a href="/listing/category/amazingpool">
            <div class="filter">
            <div>
                <i class="fa-solid fa-person-swimming"></i>
            </div>
            <p>Amazing pools</p>
        </div>
        </a>
        <a href="/listing/category/musicnight">
            <div class="filter">
            <div>
                <i class="fa-solid fa-music"></i>
            </div>
            <p>Music Night</p>
        </div>
        </a>
        <a href="/listing/category/dome">
            <div class="filter">
            <div>
                <i class="fa-solid fa-igloo"></i>
            </div>
            <p>Dome</p>
        </div>
        </a>
        <a href="/listing/category/boating">
            <div class="filter">
            <div>
                <i class="fa-solid fa-ship"></i>
            </div>
            <p>Boating</p>
        </div>
        </a>
        <div class="toggle-box">
          <div class="form-check form-switch form-check-reverse">
         <input class="form-check-input" type="checkbox" id="switchCheckReverse">
         <label class="form-check-label" for="switchCheckReverse">Display total after taxes</label>
          </div>
        </div>
    </div>
    





    <div class="allcards mt-4" >
     <% for(let data of datas){ %>
        <a href="http://localhost:3000/listing/<%= data._id %>">
            <div class="card listing-card">
            <img src="<%= data.image.url %>" class="card-img-top" alt="villa image">
            <div class="card-img-overlay"></div>
            <div class="card-body">
            <p class="card-text">
            <b><%= data.title %></b><br>
            &#8377; <%= data.price.toLocaleString("en-IN") %> /night
            <i class="GST">&nbsp; &nbsp; +18% GST</i>
            </p>
    </div>
    </div>
        </a>
<% } %>
    </div>
    <script>
       let taxswitch=document.getElementById("switchCheckReverse");
       taxswitch.addEventListener("click",()=>{
        let gst=document.getElementsByClassName("GST");
        for(let info of gst){
            if(info.style.display!="inline"){
            info.style.display="inline";
        }
        else{
            info.style.display="none";
        }
        }
       });
    </script>


