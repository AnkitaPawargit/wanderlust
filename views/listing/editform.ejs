<% layout('layouts/boilerplate') -%>
<body>
    <h3><%= data.title %></h3>
    <div class="row mt-3">
    <div class="col-8 offset-2">
    <form method="post" action="/listing/<%= data._id %>?_method=PATCH" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" placeholder="Enter title" value="<%= data.title%>" class="form-control" required>
            <div class="valid-feedback">
             valid
            </div>
        </div>
        <div class="mb-3">
            <label for="desc" class="form-label">Description</label>
            <textarea name="listing[desc]" class="form-control" required><%= data.desc %></textarea>
            <div class="valid-feedback">
             Looks good!
            </div>
        </div>
        <div class="mb-3">
            <p>Original Image</p>
            <img src="<%= data.image.url %>" id="original">
        </div>
        <!-- <div class="mb-3">
            <label for="image" class="form-label">Image(URL)</label>
            <input type="text" name="listing[image]" placeholder="Enter image URL" value="<%= data.image %>" class="form-control" required>
            <div class="valid-feedback">
             valid
            </div>
        </div> -->
        <div class="mb-3">
            <label for="image" class="form-label">Image(URL)</label>
            <input type="file" name="listing[image]" class="form-control">
        </div>
        <div class="mb-3">
            <label for="price" class="form-label">Price</label>
            <input type="text" name="listing[price]" placeholder="price" value="<%= data.price %>" class="form-control" required>
            <div class="invalid-feedback">
            Please enter valid price
           </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" placeholder="location" value="<%= data.location %>" class="form-control" required>
            <div class="invalid-feedback">
            Please enter valid loaction
           </div>
        </div>
        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" placeholder="Country" value="<%= data.country %>" class="form-control" required>
            <div class="invalid-feedback">
            Please enter valid country
           </div>
        </div>
        <div class="mt-3">
  <label for="category">Category</label>
  <select name="listing[category]" id="category" class="form-control" required>
    <option value="">Select a category</option>
    <option value="trending" <%= data?.category === 'trending' ? 'selected' : '' %>>Trending</option>
    <option value="bedrooms" <%= data?.category === 'bedrooms' ? 'selected' : '' %>>Bedrooms</option>
    <option value="mountains" <%= data?.category === 'mountains' ? 'selected' : '' %>>Mountains</option>
    <option value="castle" <%= data?.category === 'castle' ? 'selected' : '' %>>Castle</option>
    <option value="forest" <%= data?.category === 'forest' ? 'selected' : '' %>>Forest</option>
    <option value="artic" <%= data?.category === 'artic' ? 'selected' : '' %>>Artic</option>
    <option value="amazingpool" <%= data?.category === 'amazingpool' ? 'selected' : '' %>>Amazing Pool</option>
    <option value="musicnight" <%= data?.category === 'musicnight' ? 'selected' : '' %>>Music Night</option>
    <option value="dome" <%= data?.category === 'dome' ? 'selected' : '' %>>Dome</option>
    <option value="boating" <%= data?.category === 'boating' ? 'selected' : '' %>>Boating</option>
  </select>
</div>

        <button class="btn btn-dark mt-3 editbutton">EDIT</button>
    </form>
    </div>
    </div>
</body>
